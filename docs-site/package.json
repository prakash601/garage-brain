{
  "name": "garage-brain-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Docs site for Garage Brain — serves ../docs/ via Docsify (zero-build) + VitePress (build)",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev --host",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview --host",
    "serve": "vite --host --open docs-site/index.html",
    "serve:docsify": "python3 -m http.server 3000 --directory ../"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitepress": "^1.6.0",
    "mermaid": "^11.0.0"
  }
}
